{
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npm test *)", "Bash(npx tsc *)", "Bash(npx eslint *)", "Bash(npx depcruise *)",
      "Bash(npx vitest *)", "Bash(npx playwright *)", "Bash(npx supabase migration new *)", "Bash(npx supabase gen types *)",
      "Bash(git status)", "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git checkout -b *)", "Bash(git switch *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(npm install *)", "Bash(npm i *)",
      "Edit(./e2e/**)", "Edit(./supabase/tests/**)", "Edit(./src/**/*.test.ts)", "Edit(./src/**/*.test.tsx)",
      "Edit(./.github/**)", "Edit(./.claude/**)", "Edit(./eslint.config.mjs)", "Edit(./.dependency-cruiser.cjs)",
      "Edit(./AGENTS.md)", "Edit(./docs/SPEC.md)", "Edit(./docs/DATA_MODEL.md)", "Edit(./src/app/globals.css)", "Edit(./src/config/brand.ts)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)", "Read(./.env.production)",
      "Bash(npx supabase db reset *)", "Bash(npx supabase db push)", "Bash(npx supabase db push *)",
      "Bash(npx supabase link)", "Bash(npx supabase link *)", "Bash(git push --force *)", "Bash(git push -f *)", "Bash(rm -rf *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-commands.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop.sh" } ] }
    ]
  }
}
