# Copy to .env.local (never commit .env.local). Values come from the DEV Supabase project.
# Public (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare test key

# Server only (never prefix with NEXT_PUBLIC_):
SUPABASE_SECRET_KEY=sb_secret_xxx
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA   # Cloudflare test key
NOMINATIM_USER_AGENT="project-name/0.1 (contact: hola@example.org)"
